# Bu dosyayı kopyalayıp adını ".env" yapın ve kendi API anahtarlarınızı girin.
# OpenWeatherMap API: https://openweathermap.org/api
EXPO_PUBLIC_WEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API (opsiyonel - girilmezse yerleşik tavsiyeler kullanılır): https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
